local plrs = game:GetService("Players")
local plr = plrs.LocalPlayer
local mouse = plr:GetMouse()
local sg = game:GetService("StarterGui")

local function crtTT()
    local tool = Instance.new("Tool")
    tool.Name = "Teleport Tool"
    tool.RequiresHandle = false
    tool.CanBeDropped = true --press "backspace" to drop it
    tool.Parent = plr.Backpack

    tool.Activated:Connect(function()
        local char = plr.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            local target = mouse.Hit
            if target then
                local targetPos = target.Position
                local currentPos = hrp.Position
                if (targetPos - currentPos).Magnitude > 4250 then
                    sg:SetCore("SendNotification", {
                        Title = "Error!",
                        Text = "Too far! Max distance 4250 studs", --you can't teleport too far
                        Duration = 3
                    })
                    return
                end
                hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
            end
        end
    end)
end

crtTT()

plr.CharacterAdded:Connect(function() --when you die the tool is again create in your backpack
    task.wait()
    if not plr.Backpack:FindFirstChild("Teleport Tool") then
        crtTT()
    end
end)
